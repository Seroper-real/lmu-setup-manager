venv/
env/
.venv/
.env/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Pytest cache
.pytest_cache/

# MyPy cache
.mypy_cache/

# VSCode settings (ignore the folder's contents, but keep the shared launch profiles).
.vscode/*
!.vscode/launch.json

# JetBrains IDEs (PyCharm, etc.)
.idea/

# Local configuration files
*.env

# Downloads and temporary files
*.zip
*.tar.gz
*.tmp
*.log

